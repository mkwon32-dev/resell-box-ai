# Copy to backend/.env (gitignored) and fill in.
# Get a key: https://app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=
# Trained model: workspace box_ai_detection, version 6 (rfdetr-small).
# v9 yolo11s scores higher on paper (mAP50 96.5) but is overfit — finds
# nothing on real photos; v6 generalizes.
ROBOFLOW_MODEL_ID=box_ai_detection/6
